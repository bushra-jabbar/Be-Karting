<div class="container mt-5">
    <h2 class="text-warning">Edit Product</h2>
    <form action="/admin/products/edit/<%= product._id %>" method="POST" class="card p-4 bg-dark text-white">
        <div class="mb-3">
            <label>Name</label>
            <input type="text" name="name" value="<%= product.name %>" class="form-control bg-secondary text-white" required>
        </div>
        <div class="mb-3">
            <label>Price</label>
            <input type="number" name="price" value="<%= product.price %>" class="form-control bg-secondary text-white" required>
        </div>
        <button type="submit" class="btn btn-warning text-dark fw-bold">Update Product</button>
        <a href="/admin/products" class="btn btn-outline-light ms-2">Cancel</a>
    </form>
</div>