<!DOCTYPE html>
<html>
<head>
    <title>Admin Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #f8f9fa; color: #333; }
        .sidebar { height: 100vh; background: #212529; color: white; padding-top: 20px; }
        .sidebar a { color: #ccc; text-decoration: none; display: block; padding: 10px 20px; }
        .sidebar a:hover { background: #343a40; color: white; }
    </style>
</head>
<body>
    <div class="container-fluid">
    <div class="row">
        <nav class="col-md-2 sidebar bg-dark text-white vh-100">
            <h2 class="text-danger p-3">Be Admin</h2>
            <a href="/admin/products" class="nav-link text-white">Manage Products</a>
            <a href="/admin/products/add" class="nav-link text-white">Add New Product</a>
            <hr class="text-secondary">
            <a href="/" class="nav-link text-warning">Exit to Site</a>
        </nav>
        <main class="col-md-10">
            <%- body %>
        </main>
    </div>
</div>
</body>
</html>