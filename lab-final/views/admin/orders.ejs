<div class="container-fluid mt-4">
    <h2 class="text-white mb-4">Customer Orders Dashboard</h2>

    <div class="table-responsive">
        <table class="table table-dark table-hover border-secondary">
            <thead class="table-danger text-dark">
                <tr>
                    <th>Order ID</th>
                    <th>Customer Name</th>
                    <th>Email</th>
                    <th>Total Amount</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% orders.forEach(order => { %>
                    <tr>
                        <td class="small text-secondary"><%= order._id %></td>
                        <td><%= order.customerName %></td>
                        <td><%= order.email %></td>
                        <td class="text-danger fw-bold">$<%= order.totalAmount %></td>
                        <td><%= order.createdAt.toDateString() %></td>
                        <td>
                            <span class="badge <%= order.status === 'Confirmed' ? 'bg-success' : order.status === 'Cancelled' ? 'bg-danger' : 'bg-warning text-dark' %>">
                                <%= order.status %>
                            </span>
                        </td>
                        <td>
                            <form action="/admin/orders/status/<%= order._id %>" method="POST" class="d-flex gap-2">
                                <select name="status" class="form-select form-select-sm bg-dark text-white border-secondary">
                                    <option value="Pending" <%= order.status === 'Pending' ? 'selected' : '' %>>Pending</option>
                                    <option value="Confirmed" <%= order.status === 'Confirmed' ? 'selected' : '' %>>Confirmed</option>
                                    <option value="Cancelled" <%= order.status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-light">Update</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>