<div class="container mt-5">
    <h2 class="text-danger mb-4">Add New Racing Product</h2>
    
    <form action="/admin/products/add" method="POST" class="card p-4 bg-dark text-white border-secondary">
        <div class="mb-3">
            <label class="form-label">Product Name</label>
            <input type="text" name="name" class="form-control bg-secondary text-white border-0" placeholder="e.g. Pro Helmet" required>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Price ($)</label>
                <input type="number" name="price" class="form-control bg-secondary text-white border-0" required>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Category</label>
                <select name="category" class="form-select bg-secondary text-white border-0">
                    <option value="Gear">Gear</option>
                    <option value="Tires">Tires</option>
                    <option value="Apparel">Apparel</option>
                </select>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Image Filename</label>
            <input type="text" name="image" class="form-control bg-secondary text-white border-0" placeholder="e.g. helmet.png">
        </div>

        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea name="description" class="form-control bg-secondary text-white border-0" rows="3"></textarea>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger px-4">Save Product</button>
            <a href="/admin/products" class="btn btn-outline-light">Cancel</a>
        </div>
    </form>
</div>