<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Checkout | Be Karting</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

  <style>
    body { background-color: #111; color: #fff; font-family: 'Poppins', sans-serif; }
    header { background-color: #000; border-bottom: 3px solid #e10600; }
    h2, h4 { font-weight: 700; letter-spacing: 0.5px; }
    .card { background-color: #1a1a1a; border: 1px solid #333; color: #fff; }
    .form-control, .form-select { background-color: #222; border: 1px solid #444; color: #fff; height: 55px; }
    .form-control:focus, .form-select:focus { border-color: #e10600; box-shadow: none; background-color: #2a2a2a; color: white; }
    .form-floating label { color: #aaa; }
    .list-group-item { background-color: #1a1a1a; border: 1px solid #333; color: #ddd; }
    .btn-danger { background-color: #e10600; border-color: #e10600; padding: 12px; font-weight: bold; text-transform: uppercase; }
    .btn-danger:hover { background-color: darkred; border-color: darkred; }
    footer { background: #000; color: #aaa; text-align: center; padding: 20px; border-top: 4px solid #e10600; margin-top: 50px; }
    .sticky-summary { position: sticky; top: 20px; }
  </style>
</head>
<body>

<header class="py-4 text-center text-white">
  <div class="container">
    <h2 class="text-uppercase"><i class="fas fa-flag-checkered me-2 text-danger"></i>Checkout</h2>
    <div class="mt-2 small text-uppercase">
      <span class="text-secondary">Cart</span> <i class="fas fa-chevron-right mx-2 text-muted"></i>
      <span class="text-danger fw-bold">Shipping & Payment</span> <i class="fas fa-chevron-right mx-2 text-muted"></i>
      <span class="text-secondary">Confirmation</span>
    </div>
  </div>
</header>

<main class="container my-5">
  <div class="row g-4">

    <div class="col-lg-7">
      <div class="card p-4 shadow-lg mb-4">
        <h4 class="mb-4 text-danger border-bottom border-secondary pb-2">Customer & Shipping Details</h4>
        
        <form action="/place-order" method="POST" id="checkoutForm" class="row g-3">
          <div class="col-md-12 form-floating">
            <input type="text" name="fullName" class="form-control" id="name" placeholder="Full Name" required>
            <label for="name">Full Name</label>
          </div>

          <div class="col-md-6 form-floating">
            <input type="email" name="email" class="form-control" id="email" placeholder="Email" required>
            <label for="email">Email Address</label>
          </div>

          <div class="col-md-6 form-floating">
            <input type="tel" name="phone" class="form-control" id="phone" placeholder="Phone" required>
            <label for="phone">Phone Number</label>
          </div>

          <div class="col-md-12 form-floating">
            <input type="text" name="address" class="form-control" id="address" placeholder="Address" required>
            <label for="address">Shipping Address</label>
          </div>

          <div class="col-md-6 form-floating">
            <input type="text" name="city" class="form-control" id="city" placeholder="City" required>
            <label for="city">City</label>
          </div>

          <div class="col-md-6 form-floating">
            <select name="country" class="form-select" id="country" required>
              <option value="">Choose Country...</option>
              <option value="Pakistan">Pakistan</option>
              <option value="USA">USA</option>
              <option value="UK">UK</option>
            </select>
            <label for="country">Country</label>
          </div>

          <h4 class="mt-5 mb-3 text-danger border-bottom border-secondary pb-2">Payment Method</h4>
          <div class="col-12">
            <div class="form-check mb-2">
              <input class="form-check-input" type="radio" name="paymentMethod" id="cod" value="COD" checked>
              <label class="form-check-label" for="cod">Cash on Delivery (Standard)</label>
            </div>
            <div class="form-check mb-4">
              <input class="form-check-input" type="radio" name="paymentMethod" id="card" value="Card">
              <label class="form-check-label" for="card">Credit / Debit Card</label>
            </div>
          </div>

          <div class="col-12 mt-4">
            <button type="submit" id="placeOrder" class="btn btn-danger w-100 shadow">
              <i class="fas fa-check-circle me-2"></i> Confirm Order
            </button>
          </div>
        </form>
      </div>
    </div>

    <div class="card p-4 shadow-sm">
    <h4 class="mb-3 text-danger">Order Summary</h4>
    <ul class="list-group mb-3">
        <% if (session.cart && session.cart.length > 0) { %>
            <% let subtotal = 0; %>
            <% session.cart.forEach(item => { %>
                <% subtotal += item.price * item.quantity; %>
                <li class="list-group-item d-flex justify-content-between lh-sm bg-dark text-white border-secondary">
                    <div>
                        <h6 class="my-0"><%= item.name %></h6>
                        <small class="text-muted">Quantity: <%= item.quantity %></small>
                    </div>
                    <span class="text-danger fw-bold">$<%= item.price * item.quantity %></span>
                </li>
            <% }) %>
            <li class="list-group-item d-flex justify-content-between bg-black text-white">
                <span class="h5">Total</span>
                <strong class="text-danger h4">$<%= subtotal %></strong>
            </li>
        <% } else { %>
            <li class="list-group-item bg-dark text-white text-center">
                Your cart is empty. <a href="/products" class="text-danger text-decoration-none">Go Racing!</a>
            </li>
        <% } %>
    </ul>
</div>
    </div>

  </div>
</main>

<footer>
  <p>© 2025 Be Karting | Professional Racing Gear Checkout</p>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>